# ============================================================================
# Name of Application: Catalyst Trading System
# Name of file: catalyst-intl-production.cron
# Version: 1.0.0
# Last Updated: 2026-01-10
# Purpose: Cron schedule for production droplet (intl_claude)
# ============================================================================
#
# DESCRIPTION:
# This cron file runs on the international droplet (production).
# Manages intl_claude HKEX trading with proven strategies only.
#
# INSTALLATION:
# sudo cp catalyst-intl-production.cron /etc/cron.d/catalyst-intl
# sudo chmod 644 /etc/cron.d/catalyst-intl
# sudo systemctl restart cron
#
# TIMEZONE: All times in UTC (HKEX market hours converted)
# HKT = UTC + 8
# 09:00 HKT = 01:00 UTC
# 16:00 HKT = 08:00 UTC
#
# ============================================================================

# Environment
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
CATALYST_DIR=/root/catalyst-international
VENV_PYTHON=/root/catalyst-international/venv/bin/python3
LOG_DIR=/root/catalyst-international/logs

# ============================================================================
# INTL_CLAUDE - PRE-MARKET STARTUP
# ============================================================================
# 09:00 HKT = 01:00 UTC
# Reconciles monitors, ensures all positions have active monitors

0 1 * * 1-5 cd $CATALYST_DIR && $VENV_PYTHON startup_monitor.py >> $LOG_DIR/startup.log 2>&1

# ============================================================================
# INTL_CLAUDE - MORNING SESSION TRADING
# ============================================================================
# HKEX Morning: 09:30 - 12:00 HKT = 01:30 - 04:00 UTC
#
# Full trading workflow:
#   1. Check portfolio
#   2. Scan market for opportunities
#   3. Analyze candidates (proven patterns only)
#   4. Execute trades if criteria met
#   5. Position monitor starts automatically for new positions

# 09:30 HKT (01:30 UTC) - First trading cycle
30 1 * * 1-5 cd $CATALYST_DIR && $VENV_PYTHON unified_agent.py --mode trade >> $LOG_DIR/trade.log 2>&1

# 10:00 HKT (02:00 UTC)
0 2 * * 1-5 cd $CATALYST_DIR && $VENV_PYTHON unified_agent.py --mode trade >> $LOG_DIR/trade.log 2>&1

# 11:00 HKT (03:00 UTC)
0 3 * * 1-5 cd $CATALYST_DIR && $VENV_PYTHON unified_agent.py --mode trade >> $LOG_DIR/trade.log 2>&1

# ============================================================================
# INTL_CLAUDE - LUNCH BREAK
# ============================================================================
# 12:00 HKT = 04:00 UTC
# HKEX closes 12:00-13:00 for lunch
# Review positions, optionally close if patterns weak

0 4 * * 1-5 cd $CATALYST_DIR && $VENV_PYTHON unified_agent.py --mode close >> $LOG_DIR/trade.log 2>&1

# ============================================================================
# INTL_CLAUDE - AFTERNOON SESSION TRADING
# ============================================================================
# HKEX Afternoon: 13:00 - 16:00 HKT = 05:00 - 08:00 UTC

# 13:00 HKT (05:00 UTC) - Afternoon open
0 5 * * 1-5 cd $CATALYST_DIR && $VENV_PYTHON unified_agent.py --mode trade >> $LOG_DIR/trade.log 2>&1

# 14:00 HKT (06:00 UTC)
0 6 * * 1-5 cd $CATALYST_DIR && $VENV_PYTHON unified_agent.py --mode trade >> $LOG_DIR/trade.log 2>&1

# 15:00 HKT (07:00 UTC)
0 7 * * 1-5 cd $CATALYST_DIR && $VENV_PYTHON unified_agent.py --mode trade >> $LOG_DIR/trade.log 2>&1

# ============================================================================
# INTL_CLAUDE - END OF DAY
# ============================================================================
# 16:00 HKT = 08:00 UTC
# Close all positions, generate daily report

0 8 * * 1-5 cd $CATALYST_DIR && $VENV_PYTHON unified_agent.py --mode close >> $LOG_DIR/trade.log 2>&1

# ============================================================================
# INTL_CLAUDE - DAILY REPORT
# ============================================================================
# 16:30 HKT = 08:30 UTC
# Generate daily trading report

30 8 * * 1-5 cd $CATALYST_DIR && $VENV_PYTHON scripts/generate_daily_report.py >> $LOG_DIR/reports.log 2>&1

# ============================================================================
# INTL_CLAUDE - OFF-HOURS HEARTBEAT
# ============================================================================
# Process messages, update status, no trading
# Runs every 3 hours outside market hours

0 9,12,15,18,21,0 * * 1-5 cd $CATALYST_DIR && $VENV_PYTHON unified_agent.py --mode heartbeat >> $LOG_DIR/heartbeat.log 2>&1

# Weekend heartbeats (every 6 hours)
0 0,6,12,18 * * 0,6 cd $CATALYST_DIR && $VENV_PYTHON unified_agent.py --mode heartbeat >> $LOG_DIR/heartbeat.log 2>&1

# ============================================================================
# LOG ROTATION
# ============================================================================
# Clean up old logs weekly

0 0 * * 0 find $LOG_DIR -name "*.log" -mtime +30 -delete

# ============================================================================
# END OF CRON FILE
# ============================================================================
